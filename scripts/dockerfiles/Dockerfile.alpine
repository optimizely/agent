ARG GO_VERSION
FROM golang:$GO_VERSION-alpine3.23 as builder
# The official golang images set GOTOOLCHAIN=local, which blocks the Go
# toolchain declared in go.mod from being fetched when the base image's Go is
# older than go.mod's `go`/`toolchain` directives (e.g. external builders that
# pass an older GO_VERSION). Allow the pinned toolchain to be downloaded.
ENV GOTOOLCHAIN=auto
# hadolint ignore=DL3018
RUN addgroup -S agentgroup && adduser -S agentuser -G agentgroup
RUN apk add --no-cache make gcc libc-dev git curl
WORKDIR /go/src/github.com/optimizely/agent
COPY . .
RUN make setup build

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=builder /go/src/github.com/optimizely/agent/bin/optimizely /optimizely
COPY --from=builder /etc/passwd /etc/passwd
USER agentuser
# Health probe hits the admin listener's /health endpoint. Shell form is used so
# the port follows OPTIMIZELY_ADMIN_PORT when overridden at runtime (defaults to
# 8088). Uses busybox wget (bundled in the alpine base image).
# Note: this probes over plain HTTP. If the admin listener is configured for TLS
# (server.keyFile / server.certFile) it serves HTTPS and this probe will fail —
# override or drop the HEALTHCHECK in that case.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q --spider "http://127.0.0.1:${OPTIMIZELY_ADMIN_PORT:-8088}/health" || exit 1
CMD ["/optimizely"]
