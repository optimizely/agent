ARG GO_VERSION
FROM golang:$GO_VERSION as builder
RUN addgroup -u 1000 agentgroup &&\
    useradd -u 1000 agentuser -g agentgroup
WORKDIR /go/src/github.com/optimizely/agent
COPY . .
RUN make setup build &&\
    make ci_build_static_binary

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /go/src/github.com/optimizely/agent/bin/optimizely /optimizely
COPY --from=builder /etc/passwd /etc/passwd
USER agentuser
# No HEALTHCHECK instruction is defined here on purpose. This is a `scratch`
# image: it contains only the statically linked `optimizely` binary and CA
# certificates, with no shell, wget, or curl for a HEALTHCHECK command to run,
# and the binary exposes no health subcommand. Health must instead be checked
# over HTTP via the agent's /health endpoint (served on the api/webhook/admin
# listeners, admin defaults to port 8088), e.g. a Kubernetes liveness/readiness
# probe. The alpine image (Dockerfile.alpine) carries a wget-based HEALTHCHECK
# for environments that rely on Docker's native healthcheck.
CMD ["/optimizely"]

